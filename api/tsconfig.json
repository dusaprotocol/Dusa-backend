{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "es2022",
    "preserveConstEnums": true,
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "target": "es2022",
    "strictNullChecks": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"],
  "experimentalDecorators": true
}
