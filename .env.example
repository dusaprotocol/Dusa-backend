# Mandatory
DATABASE_URL=''
CHAIN_ID=0
CHAIN_URL='https://buildnet.massa.net/api/v2/'
GRPC_HOST="buildnet-explorer.massa.net"
GRPC_PORT=33037
TRACK_LIQUIDITY_TXS=true

# gRPC Backup Hosts (optional, comma-separated)
# Will automatically switch to backup nodes after 5 consecutive failures on primary
GRPC_BACKUP_HOSTS=''

# Optional
NODE_ENV=development
# HTTP port of the API / indexer (default 3001)
PORT=3001
CIRCULATING_SUPPLY_API=''
DISCORD_BOT_TOKEN=''
COINGECKO_API_KEY=''
DISCORD_WEBHOOK_FEED=''
DISCORD_WEBHOOK_ALERT=''

# Wallet keys: ONLY for the scripts that send transactions (governance/rewards).
# Never set them for the API or the indexer (they ignore them and log a warning).
# Wallet that sends the weekly rewards (scripts/src/governance.ts)
PRIV_KEY=''
# Wallet that pokes veDUSA locks (scripts/src/governance.ts)
PRIV_KEY_POKE=''

# Private lists (comma-separated addresses), kept out of the repository
# Addresses that only get 30% of their points (crons/leaderboard)
SYBIL_ADDRESSES=''
# Wallets whose voting rewards are summed in the governance logs (monitoring only)
SPECIAL_USERS=''
SPECIAL_USER=''

# Rate limiting (API and indexer): log (default: only log clients over the limit),
# enforce (reply 429) or off
RATE_LIMIT_MODE=log
# API: calls per minute per IP (each call of a tRPC batch counts) for all routes /
# for referral & Discord writes, and max calls in one batched request
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_WRITES_PER_MINUTE=10
RATE_LIMIT_MAX_BATCH=100
# Indexer: requests per minute per IP on /datastore-* and /bytecode-exports
RATE_LIMIT_NODE_PER_MINUTE=60
# Number of proxies in front of the service (Railway, Render...: 1)
TRUST_PROXY_HOPS=1

# Indexer: /connection-status returns node hosts only with header x-status-token
STATUS_TOKEN=''
